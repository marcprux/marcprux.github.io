---
import { tplStr, useTranslations } from "@/i18n";
import { res } from "@/resources/generated";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? config.site.url).href;
const platformNames: Record<string, string> = {
  facebook: res.str.footerFacebook(locale),
  telegram: res.str.footerTelegram(locale),
  mastodon: res.str.footerMastodon(locale),
  linkedin: res.str.footerLinkedIn(locale),
};
const items = config.shareLinks.map(({ name, url, linkTitle }) => {
  const title =
    linkTitle ??
    (name === "mail"
      ? t.post.sharePostViaEmail
      : platformNames[name] &&
        tplStr(t.post.sharePostOn, { platform: platformNames[name] }));
  if (!title)
    throw new Error(`Add a localized label for sharing platform: ${name}`);
  return { href: `${url}${encodeURIComponent(pageUrl)}`, title };
});
---

{
  items.length > 0 && (
    <div data-pagefind-ignore class="my-6">
      <p>{t.post.sharePostIntro}</p>
      <ul class="flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
        {items.map(({ href, title }) => (
          <li>
            <a href={href} class="inline-flex min-h-11 items-center">
              {title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
