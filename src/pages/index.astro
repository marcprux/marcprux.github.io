---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { res } from "@/resources/generated";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const home = (await getEntry("pages", "home"))!;
const { Content: Introduction } = await render(home);
const talk = (await getEntry("pages", "featured-talk"))!;
const { Content: Talk } = await render(talk);
const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);
const projects = (await getCollection("projects"))
  .filter((project) => project.data.selected)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout description={home.data.description}>
  <Header />
  <main id="main-content" class="site-shell" data-pagefind-body>
    <section class="home-intro">
      <div>
        <h1>{home.data.title}</h1><div class="intro-copy"><Introduction /></div>
      </div>
      <img
        src={res.images.portrait}
        alt={config.site.author}
        width="300"
        height="360"
        class="portrait"
        fetchpriority="high"
      />
    </section>
    <section class="home-section" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-label">
        {res.str.selectedWork(locale)}
      </h2>
      <div>
        <ul class="project-list">
          {
            projects.map(({ data }) => (
              <li class="project-item">
                <>
                  <h3>
                    <>
                      <a href={data.url}>{data.title}</a>
                      <span class="project-period">{data.period}</span>
                    </>
                  </h3>
                  <p>{data.description}</p>
                </>
              </li>
            ))
          }
        </ul><a class="section-more" href="/work/"
          >{res.str.allProjects(locale)} <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <section class="home-section" aria-labelledby="talk-heading">
      <h2 id="talk-heading" class="section-label">
        {res.str.recentTalk(locale)}
      </h2>
      <div>
        <div class="home-talks"><Talk /></div><a
          class="section-more"
          href="/talks/"
          >{res.str.viewAllTalks(locale)} <span aria-hidden="true">→</span></a>
      </div>
    </section>
    {
      posts.length > 0 && (
        <section class="home-section" aria-labelledby="writing-heading">
          <>
            <h2 id="writing-heading" class="section-label">
              {res.str.writing(locale)}
            </h2>
            <div>
              <>
                <ul class="writing-list">
                  {posts.map((post) => (
                    <Card variant="h3" summary={false} {...post} />
                  ))}
                </ul>
                <a class="section-more" href="/posts/">
                  {res.str.allWriting(locale)} <span aria-hidden="true">→</span>
                </a>
              </>
            </div>
          </>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
