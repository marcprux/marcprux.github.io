---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, postsConfig.perIndex);

const notes = await getCollection("notes");
const sortedNotes = notes.sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);
const recentNotes = sortedNotes.slice(0, 5);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="flex flex-col items-start gap-6 pt-6 pb-2 sm:flex-row sm:items-center">
      <img
        src="/headshot.png"
        alt="Marc Prud'hommeaux"
        width="120"
        height="120"
        class="border-border size-24 shrink-0 rounded-full border object-cover shadow-sm sm:size-32"
        style="view-transition-name: headshot;"
        loading="eager"
        decoding="async"
      />
      <div>
        <h1 class="mb-3">Marc Prud&rsquo;hommeaux</h1>
        <p class="text-lg leading-relaxed">
          Software developer in New England. Pronounced
          <em>ˈprʊːdəˌmoʊ</em> in en-US, <em>prydəmo</em> in fr-FR. More
          <a href={getRelativeLocaleUrl(locale, "about")}>about me</a> if
          you&rsquo;d like.
        </p>
      </div>
    </section>

    <hr />

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-8">
          <h2 class="mb-4">{t.home.recentPosts}</h2>
          <ul class="list-none p-0">
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
          <p class="mt-4">
            <a href={getRelativeLocaleUrl(locale, "posts")}>
              All posts &rarr;
            </a>
          </p>
        </section>
      )
    }

    {
      recentNotes.length > 0 && (
        <section id="recent-notes" class="mb-8">
          <h2 class="mb-4">Recent Notes</h2>
          <ul class="list-none space-y-2 p-0">
            {recentNotes.map(note => (
              <li>
                <span class="text-muted-foreground inline-block min-w-[8.5rem] text-sm tabular-nums">
                  {note.data.pubDatetime.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                  })}
                </span>
                <a href={getRelativeLocaleUrl(locale, `notes/${note.id}`)}>
                  {note.data.title}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4">
            <a href={getRelativeLocaleUrl(locale, "notes")}>
              All notes &rarr;
            </a>
          </p>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
