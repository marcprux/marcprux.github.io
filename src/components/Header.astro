---
import { getRelativeLocaleUrl } from "astro:i18n";
import { res } from "@/resources/generated";
import { useTranslations } from "@/i18n";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { path: "work", label: res.str.navWork(locale) },
  { path: "posts", label: res.str.navWriting(locale) },
  { path: "talks", label: res.str.navTalks(locale) },
  { path: "about", label: t.nav.about },
];
const Menu = res.vectors.menu;
const Close = res.vectors.close;
const Sun = res.vectors.sun;
const Moon = res.vectors.moon;
---

<a
  href="#main-content"
  class="bg-background text-accent absolute -top-full left-6 z-50 p-3 focus:top-4"
  >{t.a11y.skipToContent}</a
>
<header class="site-header site-shell">
  <div class="header-inner">
    <a class="wordmark" href={getRelativeLocaleUrl(locale, "")}
      >{config.site.title}</a
    >
    <nav aria-label={res.str.mainNavigation(locale)}>
      <button
        id="menu-btn"
        class="icon-button menu-toggle"
        aria-expanded="false"
        aria-controls="menu-items"
        aria-label={t.a11y.openMenu}
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <Menu id="menu-icon" aria-hidden="true" />
        <Close id="close-icon" class="hidden" aria-hidden="true" />
      </button>
      <ul id="menu-items" class="nav-links">
        {
          links.map((link) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, link.path)}
                aria-current={
                  path.startsWith(`/${link.path}`) ? "page" : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <button
            id="theme-btn"
            class="icon-button"
            aria-label={res.str.switchToDarkTheme(locale)}
            data-label-dark={res.str.switchToDarkTheme(locale)}
            data-label-light={res.str.switchToLightTheme(locale)}
          >
            <Moon class="dark:hidden" aria-hidden="true" /><Sun
              class="hidden dark:block"
              aria-hidden="true"
            />
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script>
  let cleanup = () => {};
  function setupMenu() {
    cleanup();
    const controller = new AbortController();
    cleanup = () => controller.abort();
    const { signal } = controller;
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector<HTMLElement>("#menu-items");
    if (!button || !menu) return;
    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        (open ? button.dataset.labelClose : button.dataset.labelOpen)!,
      );
      document.querySelector("#menu-icon")?.classList.toggle("hidden", open);
      document.querySelector("#close-icon")?.classList.toggle("hidden", !open);
    };
    button.addEventListener(
      "click",
      () => setOpen(button.getAttribute("aria-expanded") !== "true"),
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Escape" &&
          button.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false);
          button.focus();
        }
      },
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        if (
          !menu.contains(event.target as Node) &&
          !button.contains(event.target as Node)
        )
          setOpen(false);
      },
      { signal },
    );
    menu.addEventListener(
      "click",
      (event) => {
        if ((event.target as Element).closest("a")) setOpen(false);
      },
      { signal },
    );
    menu.addEventListener(
      "focusout",
      (event) => {
        if (
          !menu.contains(event.relatedTarget as Node) &&
          event.relatedTarget !== button
        )
          setOpen(false);
      },
      { signal },
    );
    window
      .matchMedia("(min-width: 601px)")
      .addEventListener("change", () => setOpen(false), { signal });
  }
  setupMenu();
  document.addEventListener("astro:page-load", setupMenu);
</script>
