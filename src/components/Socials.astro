---
import config from "@/config";
import { res } from "@/resources/generated";

const locale = Astro.currentLocale ?? config.site.lang;
const labels: Record<string, string> = {
  mail: res.str.footerEmail(locale),
  github: res.str.footerGitHub(locale),
  mastodon: res.str.footerMastodon(locale),
  linkedin: res.str.footerLinkedIn(locale),
};
const items = config.socials.map(({ name, url, linkTitle }) => {
  const label = linkTitle ?? labels[name];
  if (!label)
    throw new Error(`Add a localized label for social profile: ${name}`);
  return { url, label };
});
---

<nav
  aria-label={res.str.profileLinks(locale)}
  class="flex flex-wrap items-center gap-x-5 gap-y-2"
>
  {
    items.map(({ url, label }) => (
      <a
        href={url}
        class="inline-flex min-h-11 items-center text-muted-foreground"
      >
        {label}
      </a>
    ))
  }
</nav>
