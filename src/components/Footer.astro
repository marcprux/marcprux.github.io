---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <hr />
  <div
    class="text-muted-foreground flex flex-col items-start justify-between gap-3 pb-10 text-sm sm:flex-row sm:items-center"
  >
    <span>© {currentYear} Marc Prud&rsquo;hommeaux</span>
    <Socials />
  </div>
</footer>
