---
import type { HTMLAttributes } from "astro/types";
import { res } from "@/resources/generated";
import config from "@/config";
import { RSS_PATH } from "@/utils/rss";
type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop: _noMarginTop, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const links = [
  { href: "/contact/", label: res.str.footerContact(locale) },
  { href: "https://github.com/marcprux", label: res.str.footerGitHub(locale) },
  {
    href: "https://mastodon.social/@marcprux",
    label: res.str.footerMastodon(locale),
  },
  { href: RSS_PATH, label: res.str.footerRss(locale) },
  { href: "/search/", label: res.str.navSearch(locale) },
];
---

<footer class:list={["site-footer site-shell", className]} {...attrs}>
  <div class="footer-inner">
    <span>{config.site.title}</span>
    <nav class="footer-links" aria-label={res.str.footerNavigation(locale)}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
