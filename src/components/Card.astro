---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";
type Props = {
  variant?: "h2" | "h3";
  summary?: boolean;
} & CollectionEntry<"posts">;
const {
  variant: Heading = "h2",
  summary = true,
  id,
  data,
  filePath,
} = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="writing-item">
  <Heading><a href={getPostUrl(id, filePath, locale)}>{data.title}</a></Heading>
  <time class="post-date" datetime={data.pubDatetime.toISOString()}
    >{data.pubDatetime.getUTCFullYear()}</time
  >
  {summary && <p class="summary">{data.description}</p>}
</li>
