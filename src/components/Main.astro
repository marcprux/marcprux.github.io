---
type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  searchable?: boolean;
};
const {
  pageTitle,
  pageDesc,
  class: className,
  searchable = false,
} = Astro.props;
---

<main
  id="main-content"
  class:list={["app-layout page-main", className]}
  data-pagefind-body={searchable || undefined}
>
  <h1>{pageTitle}</h1>
  {pageDesc && <p class="page-description">{pageDesc}</p>}
  <slot />
</main>
